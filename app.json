{
  "expo": {
    "name": "Cloey",
    "slug": "cloey",
    "scheme": "cloey",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.areksahal.cloey"
    },
    "android": {
      "package": "com.areksahal.cloey"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cloey uses your photo library so you can add clothes to your wardrobe.",
          "cameraPermission": "Cloey uses the camera so you can photograph clothes for your wardrobe.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/Areks_fashion_advice",
      "typedRoutes": true
    }
  }
}
