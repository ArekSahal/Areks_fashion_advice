{
  "name": "cloey",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "node scripts/vendor-mediapipe.mjs && expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:web": "node scripts/vendor-mediapipe.mjs && expo export --platform web --output-dir dist",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:migrations": "bash scripts/check-migrations.sh",
    "vendor:mediapipe": "node scripts/vendor-mediapipe.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/metro-runtime": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@mediapipe/tasks-vision": "1.2.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~57.0.33",
    "expo-constants": "~57.0.24",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.21",
    "expo-linking": "~57.0.14",
    "expo-router": "~57.0.31",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
